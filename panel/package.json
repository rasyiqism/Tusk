{
  "name": "pg-panel-monorepo",
  "private": true,
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "dev:api": "bun --filter @panel/api dev",
    "dev:web": "bun --filter @panel/web dev",
    "build:web": "bun --filter @panel/web build",
    "typecheck": "bun --filter @panel/api typecheck && bun --filter @panel/web typecheck",
    "test": "bun --filter @panel/api test"
  }
}
