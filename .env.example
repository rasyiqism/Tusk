# PostgreSQL Superuser & PgBouncer Auth
PG_SUPERUSER_PASSWORD=change-me-strong-pg-password
PGBOUNCER_AUTH_PASSWORD=change-me-strong-pgbouncer-password

# Panel Auth & Encryption
# Generate hash with: bun -e "console.log(await Bun.password.hash('your-password', { algorithm: 'argon2id' }))"
PANEL_ADMIN_PASSWORD_HASH=
# Optional Base64-encoded Argon2id hash (recommended in Dokploy UI to avoid $ variable interpolation)
PANEL_ADMIN_PASSWORD_HASH_B64=
# 32-byte hex/base64 key for AES-256-GCM role password encryption
MASTER_KEY=change-me-32-byte-master-key-here
# Passphrase for encrypting pg_dump backups (openssl aes-256-cbc)
BACKUP_ENCRYPTION_KEY=change-me-backup-encryption-key

# S3-Compatible Backup Storage (Garage / MinIO / S3 / R2)
S3_ENDPOINT=http://minio:9000
S3_BUCKET=pg-backups
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Self-Hosted Alerts (ntfy / Webhook / SMTP)
NTFY_URL=
ALERT_WEBHOOK_URL=
ALLOW_INTERNAL_URLS=true

# Panel Runtime & Connection
PORT=3000
DATA_DIR=/app/data
PUBLIC_DB_HOST=pg.example.internal
# Bind IP for PgBouncer host ports (127.0.0.1 = local, 0.0.0.0 = public + IP allowlist)
PGB_BIND_IP=127.0.0.1
PGB_PORT=6432
# PgBouncer TLS mode: allow (supports internal plain & external ?sslmode=require) | require
PGB_TLS_MODE=allow
